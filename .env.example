LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-8b

# Critic agent: reviews the draft brief with tools and sends it back for revision
# (false = draft only, the fixed pipeline; useful for A/B)
AGENT_REVIEW=true

# Eval: judge model (empty = reuse LLM_MODEL) and whether normal runs are judged
# (after the brief is shown, so it doesn't delay it)
JUDGE_MODEL=qwen/qwen3-8b
LIVE_JUDGE=true
